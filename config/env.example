# Big Data Analytics Project - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# PostgreSQL Database Connection (SQL)
# ============================================
# Use Neon's online PostgreSQL service or your own PostgreSQL instance
PGHOST=your_postgres_host_here
PGPORT=5432
PGUSER=your_postgres_username
PGPASSWORD=your_postgres_password
PGDATABASE=your_database_name

# ============================================
# MongoDB Connection (NoSQL) - Optional
# ============================================
# Option 1: Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/

# Option 2: MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=bigdata_analytics

# ============================================
# MobileAPI Key
# ============================================
# Get your API key from: https://app.mobileapi.dev/
# See docs/MOBILEAPI_SETUP.md for instructions
MOBILEAPIKEY=your_mobile_api_key_here

# ============================================
# Kaggle API (Optional - for automatic dataset download)
# ============================================
# If you want to use download_kaggle_dataset.py
# Place your kaggle.json in:
# - Windows: C:\Users\<YourUsername>\.kaggle\kaggle.json
# - Linux/Mac: ~/.kaggle/kaggle.json
# Get it from: https://www.kaggle.com/account -> API section
